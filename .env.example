# 主 Agent 运行配置示例；复制为 .env 并填入真实值，权限 0600
SPRING_PROFILES_ACTIVE=mysql
JAVA_PORT=8600
WUYE_AGENT_MODE=mock

# MySQL（独立库 + 最小权限账号）
MYSQL_URL='jdbc:mysql://127.0.0.1:3306/wuye_agent_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false'
MYSQL_TEST_URL='jdbc:mysql://127.0.0.1:3306/wuye_agent_test_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false'
MYSQL_USERNAME=wuye_agent_app
MYSQL_PASSWORD=change-me

# 确认令牌加密密钥（AES-GCM；生产用 KMS/Vault）
CONFIRM_TOKEN_KEY=change-me

# 登录 JWT 与开发演示账号（生产必须修改/删除演示账号）
JWT_SECRET=change-me
DEV_ADMIN_PASSWORD=admin123
DEV_WORKER_PASSWORD=worker123
DEV_USER_PASSWORD=user123
# 每个用户/IP 每分钟请求上限
RATE_LIMIT_PER_MINUTE=300

# LLM 路由（默认关闭；填 DEEPSEEK_API_KEY 后设 WUYE_AI_ENABLED=true）
WUYE_AI_ENABLED=false
AI_HOST=127.0.0.1
AI_PORT=8700
AI_BASE_URL=http://127.0.0.1:8700
INTERNAL_TOKEN_J2P=change-me
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=8
LLM_MAX_TOKENS=800
LLM_CONFIDENCE_THRESHOLD=0.55
# 成本估算（元/1K token），按供应商实际价格填写；0 表示只统计 token
LLM_INPUT_PRICE_PER_1K=0
LLM_OUTPUT_PRICE_PER_1K=0

# 真实子 Agent（WUYE_AGENT_MODE=http 时生效）
AGENT_PROPERTY_BASE_URL=http://127.0.0.1:8402
AGENT_PROPERTY_INTERNAL_TOKEN=change-me
AGENT_PROPERTY_AUDIENCE=property-maintenance
AGENT_PROPERTY_ACTOR_ID=10001
AGENT_PROPERTY_ROLES=ADMIN
AGENT_PROPERTY_TENANT_ID=0

AGENT_CONTRACT_BASE_URL=http://127.0.0.1:8400
AGENT_CONTRACT_INTERNAL_TOKEN=change-me
AGENT_CONTRACT_AUDIENCE=agent-hetong
AGENT_CONTRACT_ACTOR_ID=10001
AGENT_CONTRACT_ROLES=ADMIN
AGENT_CONTRACT_TENANT_ID=1
AGENT_CONTRACT_DELEGATION_SCOPES=contract.resolve,contract.review,contract.rule.list,contract.rule.create,knowledge.search

# 外部 Agent 写入站内通知的内部令牌；留空则内部通知接口拒绝写入
NOTIFY_INTERNAL_TOKEN=change-me

# 底座 → 子 Agent 的 HMAC 身份断言密钥；留空不发送
IDENTITY_ASSERTION_SECRET=change-me

# 聊天附件本地存储与大小上限
CHAT_ATTACHMENT_ROOT=data/chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760

# 事件出口（第一阶段进程内总线）与飞轮样本
EVENT_BUS_ENABLED=true
EVENT_BUFFER_SIZE=500
FLYWHEEL_ROOT=data/flywheel
FLYWHEEL_RECENT_SIZE=200
